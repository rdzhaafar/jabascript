// Arrays: indexing, explicit &a[0] (no decay), and an insertion sort.
extern fn jaba_print_int(v: i64);
extern fn jaba_print_str(s: *u8);

fn sort(a: *i64, n: i32) {
    var i: i32 = 1;
    while i < n {
        var key: i64 = a[i];
        var j: i32 = i - 1;
        while j >= 0 && a[j] > key {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
}

fn main() -> i32 {
    var a: [6]i64;
    a[0] = 31;
    a[1] = 4;
    a[2] = -15;
    a[3] = 92;
    a[4] = 6;
    a[5] = 5;

    sort(&a[0], 6);

    var i: i32 = 0;
    while i < 6 {
        jaba_print_int(a[i]);
        jaba_print_str("\n");
        i = i + 1;
    }
    return 0;
}
